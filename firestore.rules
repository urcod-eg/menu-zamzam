rules_version = '2';

// ─────────────────────────────────────────────────────────────
// URCOD Digital Menu — قواعد الأمان (خطة Spark المجانية)
//
// الدخول بكلمة سر + كلمة أمان، والحسابات داخلية (مش بريد حقيقي):
//   المطوّر: حساب واحد ثابت dev.menu-zamzam@urcod.app
//   الإدارة: الحساب اللي رقمه مكتوب في public/meta.adminUid (المطوّر بس بيغيّره)
//
//   public/meta      { version, updatedAt, devReady, adminUid, adminLogin, license{...} }  ← الكل يقرا
//   public/menu      { schemaVersion, brand, settings, contact, categories, products, ads } ← الكل يقرا
//   private/{doc}    ملاحظات المطوّر ورقم واتساب الأدمن                                  ← المطوّر بس
//   secure/{doc}     إعدادات رفع الصور                                                     ← المطوّر يكتب، الأدمن يقرا
//   auditLogs/{id}   سجل العمليات (إضافة بس)
//
// dev.menu-zamzam@urcod.app بيتبدّل تلقائيًا بسكريبت tools/new_client.py
// الترخيص بيتفحص بوقت السيرفر (request.time) مش بساعة الجهاز.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function metaPath() { return /databases/$(database)/documents/public/meta; }
    function isDev()   { return signedIn() && request.auth.token.email == 'dev.menu-zamzam@urcod.app'; }
    function isAdmin() {
      return signedIn() && exists(metaPath()) && get(metaPath()).data.get('adminUid', '') == request.auth.uid;
    }
    function licenseOk() {
      let l = get(metaPath()).data.license;
      return l.status == 'active' && (l.endsAt == null || l.endsAt > request.time);
    }
    // كل حفظ للمنيو لازم يرفع رقم الإصدار في نفس الـ batch، عشان كاش الأجهزة يتحدّث
    function bumpsVersion() {
      return getAfter(metaPath()).data.version == get(metaPath()).data.version + 1;
    }
    function menuShapeOk() {
      return request.resource.data.keys().hasOnly(
        ['schemaVersion', 'brand', 'settings', 'contact', 'categories', 'products', 'ads', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 600
        && request.resource.data.categories.size() <= 120;
    }

    // ── المنيو العام ──
    match /public/menu {
      allow read: if true;
      allow create, update: if isDev()
        || (isAdmin() && licenseOk() && menuShapeOk() && bumpsVersion());
      allow delete: if isDev();
    }

    // ── الإصدار + الترخيص + حساب الإدارة ──
    match /public/meta {
      allow read: if true;
      allow create, delete: if isDev();
      // المطوّر: أي تعديل. الأدمن: يرفع الإصدار بواحد بس، ومايقربش من الترخيص ولا الحسابات
      allow update: if isDev()
        || (isAdmin() && licenseOk()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'updatedAt'])
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.updatedAt == request.time);
    }

    // ── بيانات المطوّر الخاصة ──
    match /private/{doc} {
      allow read, write: if isDev();
    }

    // ── إعدادات رفع الصور ──
    match /secure/{doc} {
      allow read: if isDev() || (isAdmin() && licenseOk());
      allow write: if isDev();
    }

    // ── سجل العمليات: إضافة فقط ──
    match /auditLogs/{id} {
      allow create: if (isAdmin() || isDev())
        && request.resource.data.keys().hasOnly(['uid', 'action', 'target', 'at', 'note'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow read: if isDev();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
